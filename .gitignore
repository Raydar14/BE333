# Node / npm / Yarn
node_modules/
yarn.lock
# NOTE: package-lock.json IS committed — do not ignore it. Committing the
# lockfile is what makes `npm install` reproducible for you and Raychel,
# so a run on either machine resolves the same dependency versions.
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Expo / React-Native
.expo/

# iOS / Android native folders
ios/
android/
*.xcworkspace
*.xcuserdata
*.xcodeproj
*.gradle
*.apk
*.aab

# Metro bundler cache
metro-cache/
metro-bundler-cache/
metro-config/

# Fastlane
fastlane/

# OS junk
.DS_Store
Thumbs.db

# Local env — never commit these. Secret scanning / push protection on
# GitHub will also block a push that contains an API key, but keep the
# ignore rule as belt-and-suspenders.
.env
.env.local
.env.development
.env.production
.env.*.local

# Firebase project config — contains project ID; keep out of version control
.firebaserc

# Firebase debug logs
firebase-debug.log
firebase-debug.*.log
.firebase/

# Claude Code local settings (user-specific permissions)
.claude/settings.local.json
